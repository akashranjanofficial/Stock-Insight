{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run typecheck:libs && pnpm --filter @workspace/indian-stock-analyzer build",
  "outputDirectory": "artifacts/indian-stock-analyzer/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
